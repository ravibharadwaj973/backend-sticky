# ---------------------------------------------------------------------------
# Secrets now come from AWS Secrets Manager. See "Part 3" in AWS_SETUP.md.
#
# Set AWS_SECRET_NAME and the backend loads JWT_SECRET, MONGODB_URI,
# ADMIN_EMAIL and ADMIN_PASSWORD out of the secret at boot, overwriting
# anything set below. Leave it unset and the backend uses this file as before.
#
# If AWS_SECRET_NAME is set but unreachable, the backend exits instead of
# silently starting on the stale values in this file.
# ---------------------------------------------------------------------------
# AWS_SECRET_NAME=sticky-keys

# --- Non-secret config: always read from here, never from Secrets Manager ---
NODE_ENV=development
PORT=5000
# On EC2, set this to the frontend's public origin, e.g. http://15.206.93.53:3000
CLIENT_URL=http://localhost:3000

# Keep false while the site runs on plain http:// — browsers drop Secure cookies
# without HTTPS. Set true once you have TLS.
COOKIE_SECURE=false

# Required whenever AWS_SECRET_NAME is set (that's how the SDK finds the secret)
AWS_REGION=ap-south-1

# --- Image upload flow (Lambda -> S3 -> SNS -> MongoDB), not secret ---
S3_BUCKET=
UPLOAD_LAMBDA_NAME=stickynoted-upload-image

# --- Secrets: only needed when AWS_SECRET_NAME is NOT set (local dev) ---
# In production these live in the secret, not here.
JWT_SECRET=
MONGODB_URI=
ADMIN_EMAIL=ravi@gmail.com
ADMIN_PASSWORD=123456789

# NOTE: no AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY. This runs on EC2 and the
# SDK uses the instance's IAM role. Do not put access keys in this file.
