NODE_ENV=development
PORT=5000
# On EC2, set this to the frontend's public origin, e.g. http://15.206.93.53:3000
CLIENT_URL=http://localhost:3000

# Keep false while the site runs on plain http:// — browsers drop Secure cookies
# without HTTPS. Set true once you have TLS.
COOKIE_SECURE=false

# Admin section login (these are also the code defaults)
ADMIN_EMAIL=ravi@gmail.com
ADMIN_PASSWORD=123456789


# --- AWS image upload flow (Lambda -> S3 -> SNS -> MongoDB) ---
# Always required (on EC2 and locally):
AWS_REGION=ap-south-1
S3_BUCKET=
UPLOAD_LAMBDA_NAME=stickynoted-upload-image

# Access keys: ONLY for local development. On EC2 leave these unset —
# the backend automatically uses the EC2 instance's IAM role instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

